# Target instance base URL (e.g., http://localhost:8080, https://staging.serv24.in, https://serv24.in)
BASE_URL=http://localhost:8080

# Set to true to use deterministic in-memory route mocking (recommended for CI/testing without DB pollution)
# Set to false to test against real live backend API on the instance
USE_MOCKS=true

# Test credentials when testing against a real instance (USE_MOCKS=false)
CLIENT_EMAIL=client@example.com
CLIENT_PASSWORD=password123

PROVIDER_EMAIL=provider@example.com
PROVIDER_PASSWORD=password123

ADMIN_EMAIL=admin@serv24.in
ADMIN_PASSWORD=adminSecret123
